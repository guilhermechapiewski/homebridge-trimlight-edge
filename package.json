{
  "name": "homebridge-trimlight-edge",
  "displayName": "Trimlight Edge",
  "version": "0.2.2",
  "description": "Homebridge plugin to control Trimlight Edge permanent lighting from Apple Home via the Trimlight cloud API.",
  "license": "ISC",
  "author": "Guilherme Chapiewski",
  "homepage": "https://github.com/guilhermechapiewski/homebridge-trimlight-edge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermechapiewski/homebridge-trimlight-edge.git"
  },
  "bugs": {
    "url": "https://github.com/guilhermechapiewski/homebridge-trimlight-edge/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "hoobs",
    "hoobs-plugin",
    "trimlight",
    "trimlight-edge",
    "homekit"
  ],
  "engines": {
    "node": ">=14.18.0",
    "homebridge": "^1.3.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings=0 src test scripts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "npm run build && node test/e2e/run-e2e.js",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "homebridge": "^1.11.4",
    "jest": "^29.7.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/e2e/"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  }
}
